---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import StatsOverview from '../components/StatsOverview.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { projects } from '../data/projects.js';

// Group projects by domain
const projectsByDomain = projects.reduce((acc: Record<string, typeof projects>, project) => {
  project.domain.forEach(domain => {
    if (!acc[domain]) acc[domain] = [];
    acc[domain].push(project);
  });
  return acc;
}, {} as Record<string, typeof projects>);

// Featured project
const featuredProject = projects.find(p => p.name === "Momentum")!;

// Domain colors - distinctive, intentional palette avoiding AI-generated UI tells
const domains: Record<string, { name: string; color: string; gradient: string }> = {
  'blockchain': { name: 'Blockchain', color: '#ff6b35', gradient: 'from-orange-500/20 to-orange-600/10' },
  'ai-ml': { name: 'AI & Machine Learning', color: '#00b4d8', gradient: 'from-cyan-500/20 to-cyan-600/10' },
  'computer-vision': { name: 'Computer Vision', color: '#06d6a0', gradient: 'from-teal-500/20 to-teal-600/10' },
  'mobile': { name: 'Mobile Development', color: '#ef476f', gradient: 'from-rose-500/20 to-rose-600/10' },
  'web': { name: 'Web Development', color: '#ffd23f', gradient: 'from-yellow-400/20 to-yellow-500/10' }
};

// Status symbols with meanings
const statusDisplay = {
  'complete': { symbol: '●', label: 'Shipped' },
  'in-progress': { symbol: '◐', label: 'Active' },
  'prototype': { symbol: '○', label: 'Prototype' },
  'educational': { symbol: '◇', label: 'Learning' }
};

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<PortfolioLayout title="Full-Stack Development Work">
  <!--
    THESIS: Technical breadth as visual spectrum—domains rendered as distinct color worlds, code-inspired typography, data-viz composition
    OWN-WORLD: Code editor aesthetic (syntax colors, mono type, line numbers), asymmetric grid, domain-as-color-field, technical patterns
    STORY: Visitor sees five distinct technical worlds in color, explores depth through visual navigation, understands range through chromatic organization
    FIRST VIEWPORT: Split-screen color field: amber blockchain hero (left 55%), violet AI sidebar (right 45%), both at immersive scale with technical overlays
    FORM: Technical portfolio as color-coded exhibition with code aesthetic
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
  -->

  <main class="portfolio">
    <!-- About Section -->
  <section class="about-section">
    <div class="about-container">
      <div class="about-content">
        <div class="about-text">
          <span class="section-label">< developer /></span>
          <h2 class="about-title">Vyacheslav Plotnikov</h2>
          <p class="about-tagline">Full-Stack Developer & AI Engineer</p>

          <div class="about-description">
            <p>I build intelligent systems across the stack—from iOS apps with HealthKit integration to blockchain protocols, computer vision pipelines, and AI-powered web applications.</p>

            <p>My work spans mobile development (React Native, iOS), machine learning (TensorFlow, PyTorch, YOLO), web technologies (React, Astro, Node.js), and blockchain systems. I approach each project with a focus on architecture, performance, and user experience.</p>

            <p>Currently exploring the intersection of AI and practical applications—building tools that solve real problems with modern technology.</p>
          </div>

          <div class="tech-summary">
            <div class="tech-category">
              <span class="tech-label">Languages</span>
              <span class="tech-list">Python, JavaScript, TypeScript, Solidity, Java, C++</span>
            </div>
            <div class="tech-category">
              <span class="tech-label">Specialties</span>
              <span class="tech-list">AI/ML, Computer Vision, Mobile, Blockchain, Full-Stack Web</span>
            </div>
          </div>

          <!-- Contact & Resume Actions -->
          <div class="contact-actions">
            <a href="https://github.com/nickygrey" target="_blank" rel="noopener noreferrer" class="action-btn">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"/>
              </svg>
              <span>GitHub</span>
            </a>
            <a href="mailto:ussserylzis@gmail.com" class="action-btn">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              <span>Email</span>
            </a>
            <a href={`${baseUrl}/cv.html`} target="_blank" class="action-btn action-btn-cv">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
              <span>View CV / Resume</span>
            </a>
            <div class="action-badge-location">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>Diekirch, Luxembourg</span>
            </div>
          </div>
        </div>

        <div class="about-image">
          <div class="image-frame">
            <img src={`${baseUrl}/profile.jpg`} alt="Vyacheslav Plotnikov" />
          </div>
        </div>
      </div>

      <!-- Stats Overview Row -->
      <div class="about-stats-wrapper">
        <StatsOverview />
      </div>
    </div>
  </section>

  <!-- Hero Section with Dynamic Background -->
    <section class="hero" style={`--domain-color: ${domains[featuredProject.domain[0]].color}`}>
      <div class="hero-bg-pattern"></div>

      <div class="hero-content">
        <div class="hero-label">
          <span class="line-number">001</span>
          <span class="domain-badge" style={`background: ${domains[featuredProject.domain[0]].color}; box-shadow: 0 0 20px ${domains[featuredProject.domain[0]].color}40`}>
            {domains[featuredProject.domain[0]].name}
          </span>
        </div>

        <h1 class="hero-title">
          <span class="title-line">{featuredProject.name.split(' ')[0]}</span>
          <span class="title-line">{featuredProject.name.split(' ').slice(1).join(' ')}</span>
        </h1>

        <p class="hero-tagline">{featuredProject.tagline}</p>

        <div class="hero-tech-grid">
          {featuredProject.techStack.primary.map((tech, i) => (
            <div class="tech-item" style={`animation-delay: ${i * 0.1}s`}>
              <span class="tech-bracket">[</span>
              <span class="tech-name">{tech}</span>
              <span class="tech-bracket">]</span>
            </div>
          ))}
        </div>

        <div class="hero-highlights">
          {featuredProject.features.slice(0, 3).map((feature, i) => (
            <div class="highlight-item" style={`animation-delay: ${(i + 4) * 0.1}s`}>
              <svg class="highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2"/>
              </svg>
              <span>{feature}</span>
            </div>
          ))}
        </div>

        <button class="hero-cta-btn" data-project-name={featuredProject.name} aria-label={`View deep dive for ${featuredProject.name}`}>
          <span>Inspect Architecture & Code Snippets</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>

      <div class="hero-accent-line"></div>
    </section>

    <!-- Domain Navigation Sidebar -->
    <aside class="domain-sidebar">
      <div class="sidebar-header">
        <h2 class="sidebar-title">
          <span class="title-bracket">{'<'}</span>
          Technical Domains
          <span class="title-bracket">{'/>'}</span>
        </h2>
        <div class="project-count">
          <span class="count-value">{projects.length}</span>
          <span class="count-label">projects</span>
        </div>
      </div>

      <nav class="domain-nav">
        {Object.entries(projectsByDomain).sort((a, b) => b[1].length - a[1].length).map(([domain, domainProjects]) => (
          <a href={`#${domain}`} class="nav-item" data-domain={domain}>
            <div class="nav-color-bar" style={`background: ${domains[domain].color}`}></div>
            <div class="nav-content">
              <span class="nav-name">{domains[domain].name}</span>
              <span class="nav-count">{domainProjects.length}</span>
            </div>
            <svg class="nav-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M9 5l7 7-7 7" stroke-width="2"/>
            </svg>
          </a>
        ))}
      </nav>

      <div class="sidebar-decoration">
        <div class="decoration-line"></div>
        <div class="decoration-dot"></div>
      </div>
    </aside>

    <!-- Projects by Domain -->
    <section class="catalog">
      <!-- Catalog Filter & Search Toolbar -->
      <div class="catalog-toolbar">
        <div class="search-box">
          <svg class="search-icon" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
          </svg>
          <input type="text" id="tech-search" placeholder="Search by technology, name, or keyword (e.g. Python, YOLO, React, HealthKit)..." aria-label="Search projects" />
          <button id="clear-search" class="clear-search" aria-label="Clear search" style="display: none;">✕</button>
        </div>

        <div class="filter-pills" role="tablist" aria-label="Filter by domain">
          <button class="filter-pill active" data-filter="all">All ({projects.length})</button>
          {Object.entries(projectsByDomain).sort((a, b) => b[1].length - a[1].length).map(([dom, list]) => (
            <button class="filter-pill" data-filter={dom} style={`--domain-accent: ${domains[dom].color}`}>
              {domains[dom].name} ({list.length})
            </button>
          ))}
        </div>
      </div>

      {Object.entries(projectsByDomain).sort((a, b) => b[1].length - a[1].length).map(([domain, domainProjects]) => (
        <div class="domain-block" id={domain} style={`--domain-color: ${domains[domain].color}`}>
          <div class="domain-header">
            <div class="header-top">
              <div class="domain-color-field" style={`background: linear-gradient(135deg, ${domains[domain].color}20, ${domains[domain].color}05)`}></div>
              <h2 class="domain-title">{domains[domain].name}</h2>
            </div>
            <div class="domain-meta">
              <span class="meta-count">{domainProjects.length} {domainProjects.length === 1 ? 'project' : 'projects'}</span>
              <div class="meta-line"></div>
            </div>
          </div>

          <div class="project-grid">
            {domainProjects.map((project, index) => (
              <article
                class="project-card"
                data-project-name={project.name}
                data-project-domain={domain}
                data-project-tech={project.techStack.full.join(' ').toLowerCase()}
                role="button"
                tabindex="0"
                aria-label={`View deep dive and code for ${project.name}`}
              >
                <div class="card-header">
                  <div class="card-number-group">
                    <span class="card-index">{String(index + 1).padStart(2, '0')}</span>
                    <span class="card-status" title={statusDisplay[project.status].label}>
                      {statusDisplay[project.status].symbol}
                    </span>
                  </div>
                  <div class="card-accent" style={`background: ${domains[domain].color}`}></div>
                </div>

                <h3 class="card-title">{project.name}</h3>
                <p class="card-description">{project.tagline}</p>

                <div class="card-tech">
                  {project.techStack.primary.slice(0, 4).map((tech) => (
                    <span class="card-tech-tag">{tech}</span>
                  ))}
                  {project.techStack.primary.length > 4 && (
                    <span class="card-tech-more">+{project.techStack.primary.length - 4}</span>
                  )}
                </div>

                <div class="card-footer">
                  <div class="footer-pattern">
                    <div class="pattern-dot"></div>
                    <div class="pattern-dot"></div>
                    <div class="pattern-dot"></div>
                  </div>
                  <span class="card-action-cue">Deep Dive & Code ↗</span>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- Footer Credits -->
    <footer class="portfolio-footer">
      <div class="footer-content">
        <div class="footer-badge">
          <span class="badge-bracket">{'<'}</span>
          <span>Full-Stack Development & AI Engineering</span>
          <span class="badge-bracket">{'/>'}</span>
        </div>
        <div class="footer-links">
          <a href="https://github.com/nickygrey" target="_blank" rel="noopener noreferrer">GitHub</a>
          <span class="footer-sep">·</span>
          <a href="mailto:ussserylzis@gmail.com">Email</a>
          <span class="footer-sep">·</span>
          <a href={`${baseUrl}/cv.html`} target="_blank">CV / Resume</a>
          <span class="footer-sep">·</span>
          <a href="https://github.com/nickygrey/showcase" target="_blank" rel="noopener noreferrer">Source Code</a>
        </div>
        <div class="footer-line"></div>
        <p class="footer-copy">© {new Date().getFullYear()} Vyacheslav Plotnikov · Built with Astro</p>
      </div>
    </footer>

    <!-- Back to top button -->
    <button id="back-to-top" class="back-to-top" aria-label="Scroll back to top">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M18 15l-6-6-6 6"/>
      </svg>
      <span>Top</span>
    </button>

    <!-- Project Modal Component -->
    <ProjectModal domains={domains} />

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('tech-search') as HTMLInputElement | null;
        const clearBtn = document.getElementById('clear-search');
        const filterPills = document.querySelectorAll('.filter-pill');
        const domainBlocks = document.querySelectorAll('.domain-block');
        const backToTopBtn = document.getElementById('back-to-top');

        let activeFilter = 'all';
        let searchQuery = '';

        function applyFilters() {
          const q = searchQuery.toLowerCase().trim();

          domainBlocks.forEach((block) => {
            const blockCards = block.querySelectorAll('.project-card');
            let visibleInBlock = 0;

            blockCards.forEach((card) => {
              const cardEl = card as HTMLElement;
              const cardDomain = cardEl.getAttribute('data-project-domain');
              const cardName = (cardEl.getAttribute('data-project-name') || '').toLowerCase();
              const cardTech = (cardEl.getAttribute('data-project-tech') || '').toLowerCase();
              const cardDesc = (cardEl.querySelector('.card-description')?.textContent || '').toLowerCase();

              const matchesDomain = activeFilter === 'all' || cardDomain === activeFilter;
              const matchesQuery = !q || cardName.includes(q) || cardTech.includes(q) || cardDesc.includes(q);

              if (matchesDomain && matchesQuery) {
                cardEl.style.display = 'flex';
                visibleInBlock++;
              } else {
                cardEl.style.display = 'none';
              }
            });

            // Show or hide domain section
            (block as HTMLElement).style.display = visibleInBlock > 0 ? 'block' : 'none';
          });

          if (clearBtn) {
            clearBtn.style.display = searchQuery ? 'block' : 'none';
          }
        }

        if (searchInput) {
          searchInput.addEventListener('input', (e) => {
            searchQuery = (e.target as HTMLInputElement).value;
            applyFilters();
          });
        }

        if (clearBtn && searchInput) {
          clearBtn.addEventListener('click', () => {
            searchInput.value = '';
            searchQuery = '';
            applyFilters();
            searchInput.focus();
          });
        }

        filterPills.forEach((pill) => {
          pill.addEventListener('click', () => {
            filterPills.forEach(p => p.classList.remove('active'));
            pill.classList.add('active');
            activeFilter = pill.getAttribute('data-filter') || 'all';
            applyFilters();
          });
        });

        // Keyboard accessibility for cards
        document.querySelectorAll('.project-card').forEach((card) => {
          card.addEventListener('keydown', (e: any) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              const name = card.getAttribute('data-project-name');
              if (name && (window as any).openProjectModal) {
                (window as any).openProjectModal(name);
              }
            }
          });
        });

        // Back to top
        if (backToTopBtn) {
          window.addEventListener('scroll', () => {
            if (window.scrollY > 400) {
              backToTopBtn.classList.add('is-visible');
            } else {
              backToTopBtn.classList.remove('is-visible');
            }
          });

          backToTopBtn.addEventListener('click', () => {
            if ((window as any).lenis) {
              (window as any).lenis.scrollTo(0, { duration: 1.2 });
            } else {
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }
          });
        }
      });
    </script>
  </main>
</PortfolioLayout>

<style>
  /* ============================================================================
     BASE LAYOUT & GRID
     ============================================================================ */

  .portfolio {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    grid-template-rows: auto 100vh auto auto;
    grid-template-areas:
      "about about"
      "hero sidebar"
      "catalog catalog"
      "footer footer";
    background: #0a0a0a;
    color: #ffffff;
    position: relative;
  }

  /* ============================================================================
     ABOUT SECTION
     ============================================================================ */

  .about-section {
    grid-area: about;
    background: #0a0a0a;
    padding: var(--space-32) var(--space-8);
    border-bottom: 1px solid #1a1a1a;
  }

  .about-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-16);
    align-items: start;
  }

  .about-text {
    animation: fadeInUp 0.8s ease-out;
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-sm);
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: var(--space-4);
  }

  .about-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: var(--space-2);
    line-height: 1.2;
  }

  .about-tagline {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-lg);
    color: #00b4d8;
    margin-bottom: var(--space-8);
    font-weight: 500;
  }

  .about-description {
    color: #b0b0b0;
    line-height: 1.8;
    margin-bottom: var(--space-8);
  }

  .about-description p {
    margin-bottom: var(--space-4);
  }

  .about-description p:last-child {
    margin-bottom: 0;
  }

  .tech-summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: #0f0f0f;
    border: 1px solid #1a1a1a;
    border-radius: 8px;
  }

  .tech-category {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .tech-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-xs);
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .tech-list {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-sm);
    color: #e0e0e0;
    line-height: 1.6;
  }

  .about-image {
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }

  .image-frame {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid #1a1a1a;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
  }

  .image-frame img {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(20%);
    transition: filter 0.3s ease;
  }

  .image-frame:hover img {
    filter: grayscale(0%);
  }

  /* ============================================================================
     HERO SECTION
     ============================================================================ */

  .hero {
    grid-area: hero;
    position: relative;
    padding: calc(var(--space-24) * 2) var(--space-16);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: linear-gradient(135deg, #1a1a1a 0%, #0f0f0f 100%);
    overflow: hidden;
  }

  .hero-bg-pattern {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 49%, var(--domain-color)08 50%, transparent 51%),
      linear-gradient(0deg, transparent 49%, var(--domain-color)08 50%, transparent 51%);
    background-size: 80px 80px;
    opacity: 0.3;
    animation: patternSlide 20s linear infinite;
  }

  @keyframes patternSlide {
    0% { transform: translate(0, 0); }
    100% { transform: translate(80px, 80px); }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 700px;
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .line-number {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-sm);
    color: #666;
    font-weight: 500;
    user-select: none;
  }

  .domain-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: var(--space-2) var(--space-4);
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #0a0a0a;
    animation: badgeGlow 2s ease-in-out infinite;
  }

  @keyframes badgeGlow {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; }
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    line-height: 0.95;
    margin-bottom: var(--space-6);
    letter-spacing: -0.03em;
  }

  .title-line {
    display: block;
    color: #ffffff;
  }

  .hero-tagline {
    font-size: var(--text-xl);
    line-height: 1.6;
    color: #b0b0b0;
    margin-bottom: var(--space-12);
    max-width: 600px;
  }

  .hero-tech-grid {
