---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import { projects } from '../data/projects.js';

// Group projects by domain for exhibition-style presentation
const projectsByDomain = projects.reduce((acc, project) => {
  project.domain.forEach(domain => {
    if (!acc[domain]) acc[domain] = [];
    acc[domain].push(project);
  });
  return acc;
}, {});

// Featured project (most technically diverse)
const featuredProject = projects.find(p => p.name === "Advanced Cryptocurrency Blockchain");

// Domain display names
const domainNames = {
  'mobile': 'Mobile',
  'web': 'Web',
  'ai-ml': 'AI & ML',
  'blockchain': 'Blockchain',
  'computer-vision': 'Computer Vision'
};

// Status indicators
const statusMarkers = {
  'complete': '●',
  'in-progress': '○',
  'prototype': '◐',
  'educational': '◇'
};
---

<PortfolioLayout title="Full-Stack Development Work">
  <!--
    THESIS: Technical breadth as visual fact—five domains exhibited at scale, not summarized in cards.
    OWN-WORLD: Exhibition typography (large numerals, technical mono details), asymmetric composition, domain-as-color, generous negative space.
    STORY: The visitor immediately sees full-stack range (blockchain through mobile through AI), then explores depth per domain.
    FIRST VIEWPORT: Hero project (Blockchain) takes left 60%, domain index takes right 40%, both at exhibition scale.
    FORM: Technical exhibition / portfolio showcase
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
  -->

  <main class="exhibition">
    <!-- Hero Project - Left Column -->
    <section class="hero-project">
      <div class="hero-content">
        <div class="hero-meta">
          <span class="hero-number">01</span>
          <span class="hero-domain">Blockchain</span>
        </div>

        <h1 class="hero-title">{featuredProject.name}</h1>

        <p class="hero-description">
          {featuredProject.tagline}
        </p>

        <div class="hero-tech-stack">
          {featuredProject.techStack.primary.map((tech) => (
            <span class="hero-tech">{tech}</span>
          ))}
        </div>

        <div class="hero-features">
          {featuredProject.features.slice(0, 3).map((feature) => (
            <div class="hero-feature">
              <span class="feature-marker">→</span>
              <span>{feature}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Domain Index - Right Column -->
    <aside class="domain-index">
      <div class="index-header">
        <h2 class="index-title">Technical Domains</h2>
        <div class="index-count">
          <span class="count-number">{projects.length}</span>
          <span class="count-label">Projects</span>
        </div>
      </div>

      <nav class="domain-nav">
        {Object.entries(projectsByDomain).map(([domain, domainProjects]) => (
          <a href={`#${domain}`} class="domain-link" data-domain={domain}>
            <span class="domain-name">{domainNames[domain]}</span>
            <span class="domain-count">{domainProjects.length}</span>
          </a>
        ))}
      </nav>
    </aside>

    <!-- Project Catalog by Domain -->
    <section class="project-catalog">
      {Object.entries(projectsByDomain).map(([domain, domainProjects]) => (
        <div class="domain-section" id={domain}>
          <header class="domain-header">
            <h2 class="domain-title">{domainNames[domain]}</h2>
            <span class="domain-project-count">{domainProjects.length} {domainProjects.length === 1 ? 'project' : 'projects'}</span>
          </header>

          <div class="domain-projects">
            {domainProjects.map((project, index) => (
              <article class="project-entry">
                <div class="project-index">
                  <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
                  <span class="project-status">{statusMarkers[project.status]}</span>
                </div>

                <div class="project-main">
                  <h3 class="project-title">{project.name}</h3>
                  <p class="project-description">{project.tagline}</p>

                  <div class="project-tech-list">
                    {project.techStack.primary.map((tech) => (
                      <span class="project-tech">{tech}</span>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </section>
  </main>
</PortfolioLayout>

<style>
  /* ============================================================================
     EXHIBITION LAYOUT
     ============================================================================ */

  .exhibition {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    grid-template-rows: 100vh auto;
    grid-template-areas:
      "hero index"
      "catalog catalog";
    background: linear-gradient(to bottom, #fafafa 0%, #ffffff 100vh);
  }

  /* ============================================================================
     HERO PROJECT
     ============================================================================ */

  .hero-project {
    grid-area: hero;
    padding: calc(var(--space-24) * 1.5) var(--space-12);
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid #e5e5e5;
  }

  .hero-content {
    max-width: 600px;
  }

  .hero-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .hero-number {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-5xl);
    font-weight: 700;
    color: #171717;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero-domain {
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #737373;
  }

  .hero-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.1;
    color: #171717;
    margin-bottom: var(--space-6);
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: #525252;
    margin-bottom: var(--space-8);
  }

  .hero-tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid #e5e5e5;
  }

  .hero-tech {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-xs);
    font-weight: 500;
    padding: var(--space-2) var(--space-3);
    background: #f5f5f5;
    color: #171717;
    border-radius: 4px;
  }

  .hero-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero-feature {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: #525252;
  }

  .feature-marker {
    color: #737373;
    flex-shrink: 0;
    font-weight: 600;
  }

  /* ============================================================================
     DOMAIN INDEX
     ============================================================================ */

  .domain-index {
    grid-area: index;
    padding: calc(var(--space-24) * 1.5) var(--space-8) var(--space-12);
    display: flex;
    flex-direction: column;
    background: #fafafa;
  }

  .index-header {
    margin-bottom: var(--space-12);
  }

  .index-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: #171717;
    margin-bottom: var(--space-6);
    letter-spacing: -0.01em;
  }

  .index-count {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .count-number {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-4xl);
    font-weight: 700;
    color: #171717;
    line-height: 1;
  }

  .count-label {
    font-size: var(--text-sm);
    color: #737373;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .domain-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .domain-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-4);
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 150ms ease;
  }

  .domain-link:hover {
    background: #ffffff;
  }

  .domain-name {
    font-size: var(--text-base);
    font-weight: 600;
    color: #171717;
  }

  .domain-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-sm);
    color: #737373;
  }

  /* ============================================================================
     PROJECT CATALOG
     ============================================================================ */

  .project-catalog {
    grid-area: catalog;
    padding: var(--space-24) var(--space-12);
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  .domain-section {
    margin-bottom: var(--space-24);
  }

  .domain-section:last-child {
    margin-bottom: 0;
  }

  .domain-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-6);
    border-bottom: 2px solid #171717;
  }

  .domain-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: #171717;
    letter-spacing: -0.02em;
  }

  .domain-project-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-sm);
    color: #737373;
    font-weight: 500;
  }

  .domain-projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* ============================================================================
     PROJECT ENTRY
     ============================================================================ */

  .project-entry {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-6);
    padding: var(--space-6) 0;
    border-bottom: 1px solid #e5e5e5;
  }

  .project-entry:last-child {
    border-bottom: none;
  }

  .project-index {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .project-number {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-2xl);
    font-weight: 700;
    color: #171717;
    line-height: 1;
  }

  .project-status {
    font-size: var(--text-xl);
    color: #737373;
    line-height: 1;
  }

  .project-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: #171717;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .project-description {
    font-size: var(--text-base);
    line-height: 1.5;
    color: #525252;
    margin: 0;
  }

  .project-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .project-tech {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    padding: var(--space-1) var(--space-2);
    background: #f5f5f5;
    color: #525252;
    border-radius: 3px;
  }

  /* ============================================================================
     RESPONSIVE
     ============================================================================ */

  @media (max-width: 1024px) {
    .exhibition {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      grid-template-areas:
        "hero"
        "index"
        "catalog";
    }

    .hero-project {
      border-right: none;
      border-bottom: 1px solid #e5e5e5;
      min-height: 80vh;
      padding: var(--space-16) var(--space-8);
    }

    .domain-index {
      padding: var(--space-12) var(--space-8);
    }

    .project-catalog {
      padding: var(--space-16) var(--space-8);
    }

    .project-entry {
      grid-template-columns: 60px 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero-project {
      padding: var(--space-12) var(--space-4);
    }

    .hero-number {
      font-size: var(--text-4xl);
    }

    .hero-title {
      font-size: var(--text-2xl);
    }

    .hero-description {
      font-size: var(--text-base);
    }

    .domain-index {
      padding: var(--space-8) var(--space-4);
    }

    .project-catalog {
      padding: var(--space-12) var(--space-4);
    }

    .domain-title {
      font-size: var(--text-2xl);
    }

    .project-entry {
      grid-template-columns: 50px 1fr;
      gap: var(--space-4);
    }

    .project-number {
      font-size: var(--text-xl);
    }

    .project-title {
      font-size: var(--text-lg);
    }
  }
</style>
